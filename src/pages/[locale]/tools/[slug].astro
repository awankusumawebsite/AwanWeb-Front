---
import ToolDetailPage from '../../../pages-content/ToolDetailPage.astro';
import type { Locale } from '../../../config/site';
import { getActiveTools } from '../../../lib/tools';

export async function getStaticPaths() {
  const tools = await getActiveTools();
  return (['en', 'zh'] as Locale[]).flatMap((locale) => tools.map((tool) => ({
    params: { locale, slug: tool.slug },
    props: { locale, tool },
  })));
}

const { locale, tool } = Astro.props;
---

<ToolDetailPage locale={locale} tool={tool} />
