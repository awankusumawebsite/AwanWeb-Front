---
import ServicesPage from '../../pages-content/ServicesPage.astro';

export function getStaticPaths() {
  return [
    { params: { locale: 'en' }, props: { locale: 'en' as const } },
    { params: { locale: 'zh' }, props: { locale: 'zh' as const } },
  ];
}

const { locale } = Astro.props;
---

<ServicesPage locale={locale} />
