---
import ServiceDetailPage from '../../pages-content/ServiceDetailPage.astro';
import { getServiceDetailEntries } from '../../lib/service-details';

export async function getStaticPaths() {
  const entries = await getServiceDetailEntries('id');
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { locale: 'id' as const, ...entry },
  }));
}

const { locale, slug, category, service } = Astro.props;
---

<ServiceDetailPage locale={locale} slug={slug} category={category} service={service} />
