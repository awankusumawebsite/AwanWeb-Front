---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Awan Web Astro — Migration Workspace"
  description="Workspace migrasi statis Awan Kusuma. Belum untuk production."
  locale="id"
  path="/"
  noindex={true}
>
  <main class="mx-auto flex min-h-screen max-w-3xl items-center px-6 py-16">
    <section class="rounded-3xl border border-slate-200 bg-white p-8 shadow-sm">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-cyan-700">
        Migration workspace
      </p>
      <h1 class="mt-3 text-4xl font-semibold tracking-tight text-slate-900">
        Awan Web Astro
      </h1>
      <p class="mt-4 leading-7 text-slate-600">
        Scaffold statis ini sengaja terpisah dari frontend Next.js. Halaman ini hanya
        penanda lokal dan tidak boleh dipasang ke domain production sebelum seluruh
        parity gate lulus.
      </p>
    </section>
  </main>
</BaseLayout>
