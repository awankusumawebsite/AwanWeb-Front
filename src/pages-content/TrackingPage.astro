---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteShell from '../components/layout/SiteShell.astro';
import TrackingPublicIsland from '../islands/TrackingPublicIsland';
import type { Locale } from '../config/site';
import { getMessages, localizedPath, translate } from '../lib/i18n';
import { backendOrigin } from '../lib/runtime-api';

interface Props { locale: Locale }
const { locale } = Astro.props;
const messages = await getMessages(locale);
const trackingMessages = messages.tracking as Record<string, string>;
const trackingPath = localizedPath('/lacak', locale);
const loginHref = localizedPath(`/login?redirect=${encodeURIComponent(trackingPath)}`, locale);
---

<BaseLayout
  title={translate(messages, 'tracking.title')}
  description={translate(messages, 'tracking.description')}
  locale={locale}
  path="/lacak"
  noindex
>
  <SiteShell locale={locale} path="/lacak">
    <TrackingPublicIsland
      client:load
      locale={locale}
      messages={trackingMessages}
      backendOrigin={backendOrigin(import.meta.env.PUBLIC_BACKEND_URL)}
      loginHref={loginHref}
    />
  </SiteShell>
</BaseLayout>
