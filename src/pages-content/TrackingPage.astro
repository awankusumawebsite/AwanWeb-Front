---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteShell from '../components/layout/SiteShell.astro';
import TrackingPublicIsland from '../islands/TrackingPublicIsland';
import type { Locale } from '../config/site';
import { getMessages, translate } from '../lib/i18n';
import { backendOrigin } from '../lib/runtime-api';

interface Props { locale: Locale }
const { locale } = Astro.props;
const messages = await getMessages(locale);
const trackingMessages = messages.tracking as Record<string, string>;
// Browsers reject direct localhost -> production CMS requests because production
// intentionally does not allow localhost in its credentialed CORS policy. During
// local development Vite proxies this prefix to the configured CMS origin.
const trackingBackendOrigin = import.meta.env.DEV
  ? '/__cms'
  : backendOrigin(import.meta.env.PUBLIC_BACKEND_URL);
---

<BaseLayout
  title={translate(messages, 'tracking.title')}
  description={translate(messages, 'tracking.description')}
  locale={locale}
  path="/lacak"
  noindex
>
  <SiteShell locale={locale} path="/lacak">
    <TrackingPublicIsland
      client:load
      locale={locale}
      messages={trackingMessages}
      backendOrigin={trackingBackendOrigin}
    />
  </SiteShell>
</BaseLayout>
