---
import { ArrowUpRight } from 'lucide-react';

import MarqueeImages from '../components/MarqueeImages.astro';
import SiteShell from '../components/layout/SiteShell.astro';
import type { Locale } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import { cms } from '../lib/cms';
import { getMessages, localizedPath, translate } from '../lib/i18n';
import { getServiceIcon } from '../lib/service-icons';
import { serviceCategoryId, serviceDescription, serviceParentSlug } from '../lib/services';
import { getSiteShellData } from '../lib/site-data';

interface Props {
  locale: Locale;
}

interface DataResponse<T> {
  data: T;
}

interface MarqueeImage {
  image_url: string;
  alt_text?: string | null;
}

const { locale } = Astro.props;
const [messages, shell, marqueeResponse] = await Promise.all([
  getMessages(locale),
  getSiteShellData(locale),
  cms.requestOnce<DataResponse<MarqueeImage[]>>('/marquee-images'),
]);
---

<BaseLayout
  title={translate(messages, 'metadata.servicesTitle')}
  description={translate(messages, 'metadata.servicesDescription')}
  locale={locale}
  path="/layanan"
>
  <SiteShell locale={locale} path="/layanan">
    <main class="relative w-full bg-elm/10 pb-0 pt-32 font-sans text-black selection:bg-elm selection:text-white">
      <div class="mx-auto mb-16 flex w-full max-w-7xl flex-col gap-6 px-6 md:px-12 lg:mb-24 lg:px-20">
        <h1 class="max-w-4xl text-4xl font-black uppercase leading-tight tracking-tight text-big-stone md:text-5xl lg:text-6xl xl:text-7xl">
          {translate(messages, 'servicesIndex.heading')}
        </h1>
        <p class="mt-2 max-w-2xl text-base font-medium leading-relaxed text-black/60 md:text-lg">
          {translate(messages, 'servicesIndex.description')}
        </p>
      </div>

      <div class="w-full border-t border-black/10 bg-white">
        <div class="mx-auto w-full max-w-7xl px-6 py-20 md:px-12 lg:px-20 lg:py-32">
          <div class="flex flex-col gap-24 md:gap-32 lg:gap-40">
            {
              shell.categories.map((group, index) => {
                const visibleServices = group.items.filter((item) => !item.hide_from_menu);
                if (visibleServices.length === 0) return null;

                return (
                  <section id={serviceCategoryId(group)} class="relative grid scroll-mt-32 grid-cols-1 items-start gap-10 lg:grid-cols-12 lg:gap-20">
                    <div class="z-10 lg:sticky lg:top-36 lg:col-span-5">
                      <div class="flex flex-col gap-4 md:gap-6">
                        <div class="flex items-center gap-4 border-b border-black/10 pb-4">
                          <span class="text-sm font-bold tracking-tight text-black/30 md:text-lg">({String(index + 1).padStart(2, '0')})</span>
                          <span class="text-xs font-bold uppercase tracking-widest text-elm">
                            {translate(messages, 'servicesIndex.servicesCount', { count: visibleServices.length })}
                          </span>
                        </div>
                        <h2 class="text-2xl font-black uppercase leading-[1.05] tracking-tighter text-black md:text-4xl lg:text-5xl">
                          {group.category}
                        </h2>
                      </div>
                    </div>

                    <div class="lg:col-span-7">
                      <div class="flex flex-col border-t border-black/10">
                        {visibleServices.map((item) => {
                          const Icon = getServiceIcon(item.icon_name);
                          const parentSlug = serviceParentSlug(item.slug);
                          const displayDescription = serviceDescription(item, group.items);

                          return (
                            <a
                              href={localizedPath(`/layanan/${parentSlug}`, locale)}
                              class="group -mx-2 flex flex-row items-center justify-between rounded-xl border-b border-black/10 px-2 py-5 transition-colors duration-500 hover:bg-[#fafafa] sm:-mx-8 sm:px-8 md:rounded-2xl md:py-8 lg:py-10"
                            >
                              <div class="flex items-start gap-6 sm:items-center md:gap-8">
                                <span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-black/5 text-black/40 transition-all duration-500 group-hover:bg-elm group-hover:text-white md:size-14">
                                  <Icon size={18} strokeWidth={1.5} />
                                </span>
                                <div class="flex flex-col gap-1 md:gap-2">
                                  <h3 class="text-base font-bold tracking-tight text-black transition-colors duration-500 group-hover:text-elm md:text-2xl lg:text-3xl">{item.name}</h3>
                                  {displayDescription && <p class="line-clamp-1 hidden text-sm font-medium text-black/50 md:block md:text-base">{displayDescription}</p>}
                                </div>
                              </div>
                              <span class="flex size-8 shrink-0 items-center justify-center rounded-full border border-black/10 bg-white opacity-100 shadow-sm transition-all duration-500 ease-out group-hover:translate-x-0 group-hover:border-elm group-hover:opacity-100 sm:size-12 sm:-translate-x-4 sm:opacity-0 md:size-14">
                                <ArrowUpRight className="size-4 text-elm sm:size-6" />
                              </span>
                            </a>
                          );
                        })}
                      </div>
                    </div>
                  </section>
                );
              })
            }
          </div>
        </div>
      </div>

      <div class="w-full bg-white py-20">
        <MarqueeImages images={marqueeResponse?.data || []} class="bg-transparent" />
      </div>
    </main>
  </SiteShell>
</BaseLayout>
