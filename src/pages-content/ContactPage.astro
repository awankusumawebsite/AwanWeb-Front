---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteShell from '../components/layout/SiteShell.astro';
import ContactPageIsland from '../sections/contact/ContactPageIsland';
import type { Locale } from '../config/site';
import { fallbackContactFaqs, normalizeContactInfo, type ContactFaq } from '../data/contact';
import { cms } from '../lib/cms';
import { getMessages, translate } from '../lib/i18n';
import { getSiteShellData } from '../lib/site-data';

interface Props {
  locale: Locale;
}

interface DataResponse<T> {
  data: T;
}

const { locale } = Astro.props;
const [messages, shell, faqResponse] = await Promise.all([
  getMessages(locale),
  getSiteShellData(locale),
  cms.requestOnce<DataResponse<ContactFaq[]>>(`/faqs?locale=${encodeURIComponent(locale)}&location=contact`),
]);

const contactInfo = normalizeContactInfo(shell.contact);
const apiFaqs = faqResponse?.data ?? [];
const faqData = (apiFaqs.length > 0 ? apiFaqs : fallbackContactFaqs)
  .map((faq, index) => ({ ...faq, order: faq.order || index + 1 }))
  .sort((a, b) => a.order - b.order);
const contactMessages = {
  kontakHero: messages.kontakHero,
  kontakFaq: messages.kontakFaq,
};
const legalServiceSchema = {
  '@context': 'https://schema.org',
  '@type': 'LegalService',
  name: 'Awan Kusuma Legalitas',
  url: 'https://awankusuma.com',
  logo: 'https://awankusuma.com/assets/image/logo.png',
  image: 'https://awankusuma.com/assets/image/og-image.png',
  telephone: contactInfo.whatsapp_display,
  email: contactInfo.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: contactInfo.address,
    addressLocality: 'Tangerang',
    addressRegion: 'Banten',
    postalCode: '15143',
    addressCountry: 'ID',
  },
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
    opens: '09:00',
    closes: '17:00',
  },
  priceRange: '$$',
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqData.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer },
  })),
};
---

<BaseLayout
  title={translate(messages, 'metadata.contactTitle')}
  description={translate(messages, 'metadata.contactDescription')}
  locale={locale}
  path="/kontak"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(legalServiceSchema)}></script>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
  <SiteShell locale={locale} path="/kontak">
    <ContactPageIsland
      client:load
      locale={locale}
      messages={contactMessages}
      contactInfo={contactInfo}
      categories={shell.categories}
      faqData={faqData}
    />
  </SiteShell>
</BaseLayout>
