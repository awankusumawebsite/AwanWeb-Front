---
interface MarqueeImage {
  image_url: string;
  alt_text?: string | null;
}

interface Props {
  images?: MarqueeImage[];
  class?: string;
}

const fallbackImages: MarqueeImage[] = [
  { image_url: '/images/mockups/photo-1542744173-8e7e53415bb0.webp' },
  { image_url: '/images/mockups/photo-1522071820081-009f0129c71c.webp' },
  { image_url: '/images/mockups/photo-1600880292203-757bb62b4baf.webp' },
  { image_url: '/images/mockups/photo-1552664730-d307ca884978.webp' },
  { image_url: '/images/mockups/photo-1454165804606-c3d57bc86b40.webp' },
  { image_url: '/images/mockups/photo-1589829085413-56de8ae18c73.webp' },
];

const { images = [], class: className = 'bg-white' } = Astro.props;
const sourceImages = images.length > 0 ? images : fallbackImages;
let safeImages = [...sourceImages];

while (safeImages.length < 6) {
  safeImages = [...safeImages, ...sourceImages];
}

const marqueeItems = [...safeImages, ...safeImages];
const duration = `${safeImages.length * 6}s`;
---

<section class:list={['relative z-10 flex w-full flex-col items-center overflow-hidden py-10', className]}>
  <div class="relative flex w-full overflow-hidden">
    <div class="pointer-events-none absolute inset-y-0 left-0 z-10 w-12 bg-linear-to-r from-white to-transparent md:w-24"></div>
    <div class="pointer-events-none absolute inset-y-0 right-0 z-10 w-12 bg-linear-to-l from-white to-transparent md:w-24"></div>
    <div class="astro-marquee flex w-max gap-4 px-2 md:gap-6 md:px-3" style={`--marquee-duration: ${duration}`}>
      {
        marqueeItems.map((image, index) => (
          <div class="relative aspect-video w-[55vw] shrink-0 overflow-hidden rounded-xl border border-slate-100 bg-slate-100 shadow-sm md:w-[300px] lg:w-[400px]">
            <img
              src={image.image_url}
              alt={image.alt_text || `Awan Kusuma activity ${index + 1}`}
              loading="lazy"
              decoding="async"
              class="absolute inset-0 h-full w-full object-cover"
              width="400"
              height="225"
            />
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  @keyframes astro-marquee {
    from { transform: translateX(-50%); }
    to { transform: translateX(0); }
  }

  .astro-marquee {
    animation: astro-marquee var(--marquee-duration) linear infinite;
    will-change: transform;
  }

  @media (prefers-reduced-motion: reduce) {
    .astro-marquee {
      animation-play-state: paused;
    }
  }
</style>
