---
import type { Locale } from '../../config/site';
import { localizedPath } from '../../lib/i18n';

interface Props {
  locale: Locale;
  copy: Record<string, string>;
}

const { locale, copy } = Astro.props;
const aboutPath = localizedPath('/tentang-kami', locale);
const gallery = [
  ['/images/mockups/image-1.webp', 'Ruang kerja tim Awan Kusuma Legalitas'],
  ['/images/mockups/image-2.webp', 'Tim legal sedang berdiskusi'],
  ['/images/mockups/image-3.webp', 'Konsultasi hukum dengan klien'],
  ['/images/mockups/image-4.webp', 'Fasilitas kantor profesional'],
];
---

<section data-home-about class="relative z-10 w-full bg-white pb-10 pt-10 md:pb-20 md:pt-16">
  <div class="mx-auto flex max-w-7xl flex-col items-center px-10 md:px-20 lg:px-32">
    <div class="mb-16 flex w-full max-w-xl flex-col items-center text-left md:mb-28">
      <p class="mb-6 w-full text-sm font-medium leading-snug text-black sm:text-base md:text-lg lg:text-xl">
        <strong>{copy.companyName} <span class="text-orange-400">{copy.companyTag}</span></strong><br />
        {copy.paragraph1}
      </p>
      <p class="mb-10 w-full text-sm font-medium leading-snug text-black sm:text-base md:text-lg lg:text-xl">
        {copy.paragraph2}
      </p>
      <a href={aboutPath} class="group flex items-center gap-4 self-start">
        <span class="flex size-10 items-center justify-center rounded-full border border-gray-300 transition-colors group-hover:border-elm group-hover:bg-elm">
          <span class="text-lg text-black transition-colors group-hover:text-white">→</span>
        </span>
        <span class="text-xs font-extrabold uppercase tracking-widest text-black transition-colors group-hover:text-elm">{copy.seeMore}</span>
      </a>
    </div>
  </div>

  <div class="mb-20 w-full overflow-hidden px-4 md:px-20 lg:px-35">
    <div class="grid min-w-[700px] grid-cols-12 items-start gap-3">
      {gallery.map(([src, alt], index) => (
        <div class:list={['relative overflow-hidden rounded-md', index % 2 === 0 ? 'col-span-4 aspect-[4/3]' : 'col-span-2 mt-10 aspect-[2/3]']}>
          <img src={src} alt={alt} width="620" height="465" loading="lazy" decoding="async" class="absolute inset-0 size-full object-cover" />
        </div>
      ))}
    </div>
  </div>

  <div class="mx-auto w-full max-w-7xl px-6 md:px-12 lg:px-20">
    <h2 class="text-2xl font-black uppercase leading-tight tracking-tight text-big-stone md:text-4xl lg:text-5xl">{copy.sectionHeading}</h2>
    <p class="mt-2 text-xs font-extrabold uppercase tracking-[0.2em] text-elm md:text-sm">◆ {copy.sectionSubheading}</p>
    <div class="mt-10 grid grid-cols-1 gap-6 border-y border-black/10 py-10 md:grid-cols-2">
      <a href={aboutPath} class="group relative aspect-[4/3] overflow-hidden rounded-2xl md:aspect-[16/10]">
        <img src="/images/mockups/photo-1589994965851-a8f479c573a9.webp" alt={copy.aboutUsCard} width="800" height="500" loading="lazy" class="absolute inset-0 size-full object-cover transition-transform duration-700 group-hover:scale-105" />
        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
        <div class="absolute inset-x-0 bottom-0 p-7 text-white"><h3 class="text-2xl font-black uppercase">{copy.aboutUsCard}</h3><p class="mt-2 text-xs font-bold uppercase tracking-[0.2em] text-white/70">{copy.aboutUsSubtitle}</p></div>
      </a>
      <a href={`${aboutPath}#why-us`} class="group relative aspect-[4/3] overflow-hidden rounded-2xl md:aspect-[16/10]">
        <img src="/images/mockups/image-5.webp" alt={copy.whyUsCard} width="800" height="500" loading="lazy" class="absolute inset-0 size-full object-cover transition-transform duration-700 group-hover:scale-105" />
        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
        <div class="absolute inset-x-0 bottom-0 p-7 text-white"><h3 class="text-2xl font-black uppercase">{copy.whyUsCard}</h3><p class="mt-2 text-xs font-bold uppercase tracking-[0.2em] text-white/70">{copy.whyUsSubtitle}</p></div>
      </a>
    </div>
    <div class="grid grid-cols-1 border-b border-black/10 md:grid-cols-2">
      <a href={`${aboutPath}#visi-misi`} class="flex items-center justify-between border-b border-black/10 px-2 py-7 text-sm font-black uppercase tracking-[0.2em] transition-colors hover:text-elm md:border-b-0 md:border-r md:px-8">{copy.visiMisiLink}<span>→</span></a>
      <a href={`${aboutPath}#culture`} class="flex items-center justify-between px-2 py-7 text-sm font-black uppercase tracking-[0.2em] transition-colors hover:text-elm md:px-8">{copy.budayaLink}<span>→</span></a>
    </div>
  </div>
</section>
