---
import { homeMediaUrl, type HomeTestimonial } from '../../lib/home';
import TestimonialsCarouselIsland from '../../islands/TestimonialsCarouselIsland';

interface Props {
  testimonials: HomeTestimonial[];
  heading: string;
  subheading: string;
}

const fallback: HomeTestimonial[] = [
  { name: 'Sushen Qoirunnisa', role: 'Founding Team, PT Delta Surya', avatar: 'https://i.pravatar.cc/150?img=47', quote: 'Pengurusan PKKPR cepat kilat, kurang dari 1 hari jadi semua mantap dan sukses berkat tim Awan Kusuma.' },
  { name: 'Dina Rahmawati', role: 'CEO, Maju Bersama CV', avatar: 'https://i.pravatar.cc/150?img=49', quote: 'Pelayanannya ramah, cepat dan tepat. Sangat direkomendasikan.' },
  { name: 'Budi Hartono', role: 'Direktur, PT Nusantara Raya', avatar: 'https://i.pravatar.cc/150?img=12', quote: 'Proses legalitas bisnis menjadi jauh lebih mudah bersama tim Awan Kusuma.' },
];

const { testimonials, heading, subheading } = Astro.props;
const source = testimonials.length > 0 ? testimonials : fallback;
const carouselItems = source.map((item) => ({
  id: item.id,
  name: item.name,
  role: item.role,
  quote: item.quote,
  avatar: homeMediaUrl(item.avatar),
}));
---

<section class="relative w-full overflow-hidden py-28" style="background:linear-gradient(160deg,#dff0f5 0%,#f5f7f8 40%,#e0edf5 100%)">
  <div class="absolute -top-1 left-1/2 z-10 h-24 w-[110%] -translate-x-1/2 rounded-b-[100%] bg-white"></div>
  <div class="relative z-20 mb-12 px-6 pt-8 text-center">
    <h2 class="text-4xl font-black leading-tight tracking-tight text-big-stone md:text-6xl lg:text-7xl">{heading}</h2>
    <p class="mt-4 text-xs font-extrabold uppercase tracking-[0.3em] text-elm md:text-sm">{subheading}</p>
  </div>
  <TestimonialsCarouselIsland client:visible={{ rootMargin: '800px' }} testimonials={carouselItems} />
  <div class="absolute -bottom-1 left-1/2 z-10 h-24 w-[110%] -translate-x-1/2 rounded-t-[100%] bg-white"></div>
</section>
