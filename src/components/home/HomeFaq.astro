---
import type { Locale } from '../../config/site';
import type { HomeFaq as HomeFaqItem } from '../../lib/home';
import { localizedPath } from '../../lib/i18n';

interface Props {
  locale: Locale;
  faqs: HomeFaqItem[];
  heading: string;
  subheading: string;
  ctaText: string;
}

const fallback: HomeFaqItem[] = [
  { question: 'Berapa lama proses pendirian perusahaan (PT/CV)?', answer: 'Proses umumnya memakan waktu sekitar 7 hingga 14 hari kerja setelah seluruh persyaratan lengkap diterima.' },
  { question: 'Apakah harus datang langsung ke kantor?', answer: 'Tidak. Konsultasi dan pengurusan dapat dilakukan secara online, dengan dokumen dikirim secara digital atau melalui kurir.' },
  { question: 'Bagaimana cara memulai konsultasi?', answer: 'Hubungi tim kami untuk analisis awal kebutuhan bisnis dan penentuan strategi penanganan yang paling efisien.' },
];

const { locale, faqs, heading, subheading, ctaText } = Astro.props;
const items = faqs.length > 0 ? faqs : fallback;
---

<section class="relative w-full bg-white py-15 font-sans md:py-20">
  <div class="container mx-auto max-w-[1400px] px-6 md:px-12 xl:px-24">
    <div class="flex flex-col justify-between gap-16 lg:flex-row lg:gap-24">
      <div class="flex w-full flex-col items-start lg:w-[35%]">
        <h2 class="mb-3 text-3xl font-extrabold leading-tight tracking-tight text-big-stone md:text-4xl lg:text-[42px]">{heading}</h2>
        <p class="text-sm font-bold uppercase tracking-widest text-elm">◆ {subheading}</p>
      </div>
      <div class="w-full border-t border-slate-200 lg:w-[65%]">
        {items.map((faq) => (
          <details class="group border-b border-slate-200">
            <summary class="flex cursor-pointer list-none items-center justify-between py-6 md:py-8">
              <h3 class="pr-8 text-[15px] font-medium text-black transition-colors group-hover:text-elm md:text-[17px]"><strong class="mr-4 text-lg">Q.</strong>{faq.question}</h3>
              <span class="shrink-0 text-xl text-slate-400 transition-transform group-open:rotate-180">⌄</span>
            </summary>
            <p class="pb-8 pl-10 pr-4 text-[15px] leading-relaxed text-slate-500 md:pl-12 lg:pr-16">{faq.answer}</p>
          </details>
        ))}
        <div class="mt-12 flex justify-end">
          <a href={`${localizedPath('/kontak', locale)}#faq`} class="group flex items-center gap-5 text-sm font-black tracking-wide text-big-stone transition-colors hover:text-elm"><span class="flex size-12 items-center justify-center rounded-full border border-gray-300 text-elm transition-colors group-hover:border-elm group-hover:bg-elm group-hover:text-white">→</span>{ctaText}</a>
        </div>
      </div>
    </div>
  </div>
</section>
