---
import type { Locale } from '../../config/site';
import type { HomeFaq as HomeFaqItem } from '../../lib/home';
import { localizedPath } from '../../lib/i18n';

interface Props {
  locale: Locale;
  faqs: HomeFaqItem[];
  heading: string;
  subheading: string;
  ctaText: string;
}

const fallback: HomeFaqItem[] = [
  { question: 'Berapa lama proses pendirian perusahaan (PT/CV)?', answer: 'Proses umumnya memakan waktu sekitar 7 hingga 14 hari kerja setelah seluruh persyaratan lengkap diterima.' },
  { question: 'Apakah harus datang langsung ke kantor?', answer: 'Tidak. Konsultasi dan pengurusan dapat dilakukan secara online, dengan dokumen dikirim secara digital atau melalui kurir.' },
  { question: 'Bagaimana cara memulai konsultasi?', answer: 'Hubungi tim kami untuk analisis awal kebutuhan bisnis dan penentuan strategi penanganan yang paling efisien.' },
];

const { locale, faqs, heading, subheading, ctaText } = Astro.props;
const items = faqs.length > 0 ? faqs : fallback;
---

<section class="relative w-full bg-white py-15 font-sans md:py-20">
  <div class="container mx-auto max-w-[1400px] px-6 md:px-12 xl:px-24">
    <div class="flex flex-col justify-between gap-16 lg:flex-row lg:gap-24">
      <div class="flex w-full flex-col items-start lg:w-[35%]">
        <h2 class="mb-3 text-3xl font-extrabold leading-tight tracking-tight text-big-stone md:text-4xl lg:text-[42px]">{heading}</h2>
        <p class="text-sm font-bold uppercase tracking-widest text-elm">◆ {subheading}</p>
      </div>
      <div class="w-full border-t border-slate-200 lg:w-[65%]" data-home-faq-accordion>
        {items.map((faq, index) => {
          const questionId = `home-faq-question-${index}`;
          const panelId = `home-faq-panel-${index}`;

          return (
            <div class="faq-row overflow-hidden border-b border-slate-200" data-faq-row>
              <h3>
                <button
                  id={questionId}
                  type="button"
                  class="group flex w-full cursor-pointer items-center justify-between py-6 text-left md:py-8"
                  aria-expanded="false"
                  aria-controls={panelId}
                  data-faq-toggle
                >
                  <span class="pr-8 text-[15px] font-medium text-black transition-colors duration-300 group-hover:text-elm md:text-[17px]">
                    <strong class="mr-4 text-lg">Q.</strong>{faq.question}
                  </span>
                  <span class="faq-icon shrink-0 text-slate-400 transition-[color,transform] duration-[400ms] ease-[cubic-bezier(0.76,0,0.24,1)] group-hover:text-elm" data-faq-icon>
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.25" d="m6 9 6 6 6-6"></path>
                    </svg>
                  </span>
                </button>
              </h3>
              <div
                id={panelId}
                class="faq-panel grid grid-rows-[0fr] opacity-0 transition-[grid-template-rows,opacity] duration-500 ease-[cubic-bezier(0.76,0,0.24,1)]"
                role="region"
                aria-labelledby={questionId}
                aria-hidden="true"
                data-faq-panel
              >
                <div class="overflow-hidden">
                  <p class="pb-8 pl-10 pr-4 text-[15px] leading-relaxed text-slate-500 md:pl-12 lg:pr-16">{faq.answer}</p>
                </div>
              </div>
            </div>
          );
        })}
        <div class="mt-12 flex justify-end">
          <a href={`${localizedPath('/kontak', locale)}#faq`} class="group flex items-center gap-5 transition-opacity"><span class="flex h-12 w-12 items-center justify-center rounded-full border border-gray-300 transition-[background-color,border-color] duration-300 ease-[cubic-bezier(0.76,0,0.24,1)] group-hover:border-elm group-hover:bg-elm group-hover:duration-500"><svg class="h-4 w-4 text-elm transition-[color,transform] duration-300 ease-[cubic-bezier(0.76,0,0.24,1)] group-hover:translate-x-1 group-hover:text-white group-hover:duration-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg></span><span class="text-sm font-black tracking-wide text-[#0f172a] transition-colors duration-300 group-hover:text-elm group-hover:duration-500">{ctaText}</span></a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .faq-row.is-open .faq-panel {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  .faq-row.is-open .faq-icon {
    color: var(--color-elm, #1f8198);
    transform: rotate(180deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-panel,
    .faq-icon {
      transition-duration: 1ms;
    }
  }
</style>

<script>
  const setFaqOpen = (row: HTMLElement, isOpen: boolean) => {
    const toggle = row.querySelector<HTMLButtonElement>('[data-faq-toggle]');
    const panel = row.querySelector<HTMLElement>('[data-faq-panel]');

    row.classList.toggle('is-open', isOpen);
    toggle?.setAttribute('aria-expanded', String(isOpen));
    panel?.setAttribute('aria-hidden', String(!isOpen));
  };

  const initHomeFaq = () => {
    document.querySelectorAll<HTMLElement>('[data-home-faq-accordion]').forEach((accordion) => {
      if (accordion.dataset.faqReady === 'true') return;

      accordion.dataset.faqReady = 'true';
      const rows = Array.from(accordion.querySelectorAll<HTMLElement>('[data-faq-row]'));

      rows.forEach((row) => {
        const toggle = row.querySelector<HTMLButtonElement>('[data-faq-toggle]');
        if (!toggle) return;

        toggle.addEventListener('click', () => {
          const shouldOpen = toggle.getAttribute('aria-expanded') !== 'true';

          rows.forEach((candidate) => setFaqOpen(candidate, false));
          if (shouldOpen) setFaqOpen(row, true);
        });
      });
    });
  };

  initHomeFaq();
  document.addEventListener('astro:page-load', initHomeFaq);
</script>
