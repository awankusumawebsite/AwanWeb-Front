---
import type { Locale } from '../../config/site';
import { localizedPath } from '../../lib/i18n';
import { serviceDescription, serviceParentSlug } from '../../lib/services';
import type { ServiceMenuGroup } from '../../lib/site-data';

interface Props {
  locale: Locale;
  categories: ServiceMenuGroup[];
  heading: string;
  subheading: string;
  viewAll: string;
  countTemplate: string;
}

const { locale, categories, heading, subheading, viewAll, countTemplate } = Astro.props;
---

<section class="relative w-full overflow-hidden bg-white pb-20 pt-16 font-sans text-big-stone">
  <div class="mx-auto mb-12 max-w-7xl px-6 md:px-12 lg:px-20">
    <h2 class="text-2xl font-black uppercase leading-tight tracking-tight md:text-3xl lg:text-4xl">{heading}</h2>
    <p class="mt-2 text-sm font-extrabold uppercase tracking-widest text-elm md:text-base">◆ {subheading}</p>
  </div>

  <div class="w-full">
    {categories.slice(0, 5).map((category, index) => {
      const visibleItems = category.items.filter((item) => !item.hide_from_menu);
      if (visibleItems.length === 0) return null;
      return (
        <details class="group mx-auto max-w-7xl border-t border-black/10 px-6 open:border-elm md:px-12 lg:px-20">
          <summary class="flex cursor-pointer list-none items-center justify-between py-5 lg:py-6">
            <div class="flex items-center gap-4 md:gap-8 lg:gap-12">
              <span class="w-8 shrink-0 text-xs font-medium text-black/40 md:text-sm">({String(index + 1).padStart(2, '0')})</span>
              <h3 class="text-xl font-black uppercase tracking-tighter transition-transform duration-500 group-hover:translate-x-3 group-open:text-elm sm:text-2xl md:text-3xl lg:text-4xl">{category.category}</h3>
            </div>
            <div class="ml-4 flex shrink-0 items-center gap-5">
              <span class="hidden text-xs font-bold uppercase tracking-widest text-black/30 md:block">{countTemplate.replace('{count}', String(visibleItems.length))}</span>
              <span class="flex size-9 items-center justify-center rounded-full border border-black/10 text-xl transition-all group-open:rotate-45 group-open:border-elm group-open:bg-elm group-open:text-white">+</span>
            </div>
          </summary>
          <div class="grid grid-cols-1 gap-3 pb-10 pt-2 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 md:pl-16">
            {visibleItems.map((item) => {
              const parentSlug = serviceParentSlug(item.slug);
              const description = serviceDescription(item, category.items);
              return (
                <a href={localizedPath(`/layanan/${parentSlug}`, locale)} class="group/card flex min-h-[140px] flex-col justify-between rounded-xl border border-black/5 bg-[#fafafa] p-5 transition-all hover:border-black/10 hover:bg-white hover:shadow-lg md:min-h-[160px]">
                  <div class="flex items-start justify-between"><span class="flex size-8 items-center justify-center rounded-lg bg-black/5 text-sm text-elm">◆</span><span class="opacity-0 transition-opacity group-hover/card:opacity-100">↗</span></div>
                  <div><h4 class="text-base font-bold tracking-tight text-black md:text-lg">{item.name}</h4>{description && <p class="mt-1 line-clamp-2 text-xs font-medium leading-relaxed text-black/50">{description}</p>}</div>
                </a>
              );
            })}
          </div>
        </details>
      );
    })}
  </div>

  <div class="mx-auto mt-10 flex max-w-7xl justify-end px-6 md:px-12 lg:px-20">
    <a href={localizedPath('/layanan', locale)} class="group flex items-center gap-4 text-xs font-bold uppercase tracking-widest transition-colors hover:text-elm"><span class="flex size-10 items-center justify-center rounded-full border border-gray-300 transition-colors group-hover:border-elm group-hover:bg-elm group-hover:text-white">→</span>{viewAll}</a>
  </div>
</section>
