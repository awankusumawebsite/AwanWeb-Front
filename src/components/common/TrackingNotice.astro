---
import type { Locale } from '../../config/site';
import type { MessageTree } from '../../lib/i18n';
import { localizedPath, translate } from '../../lib/i18n';

interface Props {
  locale: Locale;
  messages: MessageTree;
}

const { locale, messages } = Astro.props;
---

<aside id="tracking-notice" class="fixed inset-x-0 bottom-0 z-20 hidden w-full p-3 md:bottom-6 md:left-6 md:right-auto md:w-[340px]" aria-label={translate(messages, 'cookieConsent.title')} role="status">
  <div class="relative overflow-hidden rounded-2xl border border-gray-100 bg-white/95 p-4 pr-12 shadow-[0_10px_40px_-10px_rgba(0,0,0,0.15)] backdrop-blur-2xl">
    <button id="tracking-notice-dismiss" type="button" aria-label={translate(messages, 'cookieConsent.dismiss')} class="absolute right-1.5 top-1.5 z-10 inline-flex size-11 items-center justify-center rounded-full text-slate-400 transition-colors hover:bg-slate-100 hover:text-big-stone focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-elm">
      <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-width="2" d="M6 6l12 12M18 6L6 18"></path></svg>
    </button>
    <div class="flex items-start gap-2.5">
      <span class="mt-0.5 text-lg leading-none" aria-hidden="true">📊</span>
      <p class="text-[11px] leading-snug text-slate-600">
        {translate(messages, 'cookieConsent.description')}{' '}
        <a href={localizedPath('/kebijakan-privasi', locale)} class="font-bold text-elm underline underline-offset-2 transition-colors hover:text-orange-500">{translate(messages, 'cookieConsent.privacyLink')}</a>
      </p>
    </div>
  </div>
</aside>

<script is:inline>
  (() => {
    const key = 'awan_tracking_notice_seen';
    const notice = document.getElementById('tracking-notice');
    const dismissButton = document.getElementById('tracking-notice-dismiss');
    let timer;

    const dismiss = () => {
      try { window.localStorage.setItem(key, '1'); } catch {}
      notice?.remove();
      if (timer) window.clearTimeout(timer);
    };

    let seen = false;
    try { seen = window.localStorage.getItem(key) === '1'; } catch {}
    if (seen) {
      notice?.remove();
      return;
    }

    notice?.classList.remove('hidden');
    dismissButton?.addEventListener('pointerdown', dismiss);
    dismissButton?.addEventListener('click', dismiss);
    timer = window.setTimeout(dismiss, 5_000);
  })();
</script>
