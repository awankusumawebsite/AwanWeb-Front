---
import type { Locale } from '../../config/site';
import type { MessageTree } from '../../lib/i18n';
import { localizedPath, translate } from '../../lib/i18n';
import { getServiceIcon } from '../../lib/service-icons';
import type { ServiceMenuGroup } from '../../lib/site-data';
import AuthNav from './AuthNav.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  locale: Locale;
  path: string;
  messages: MessageTree;
  categories?: ServiceMenuGroup[];
  backendOrigin: string;
  availableLocales?: readonly Locale[];
}

const { locale, path, messages, categories = [], backendOrigin, availableLocales } = Astro.props;
const navItems = [
  { key: 'about', href: '/tentang-kami' },
  { key: 'services', href: '/layanan', services: true },
  { key: 'articles', href: '/info-bisnis' },
  { key: 'tools', href: '/tools', literal: 'TOOLS' },
  { key: 'tracking', href: '/lacak' },
];
const mobileNavItems = [
  ...navItems,
  { key: 'contact', href: '/kontak' },
];
const localeLinks = [
  { code: 'id' as const, label: 'ID', flag: '🇮🇩', name: 'Indonesia' },
  { code: 'en' as const, label: 'EN', flag: '🇬🇧', name: 'English' },
  { code: 'zh' as const, label: 'ZH', flag: '🇨🇳', name: '中文' },
].filter((item) => !availableLocales || availableLocales.includes(item.code)).map((item) => ({
  ...item,
  href: localizedPath(path, item.code),
  active: locale === item.code,
}));

const isActive = (href: string) => href === '/'
  ? path === '/'
  : path === href || path.startsWith(`${href}/`);
const authLabels = {
  login: translate(messages, 'navbar.login'),
  account: translate(messages, 'navbar.account'),
  activeAccount: translate(messages, 'navbar.activeAccount'),
  adminDashboard: translate(messages, 'navbar.adminDashboard'),
  partnerPortal: translate(messages, 'navbar.partnerPortal'),
  customerPortal: translate(messages, 'navbar.customerPortal'),
  logout: translate(messages, 'navbar.logout'),
  retry: translate(messages, 'navbar.retryAccount'),
};
---

<div id="site-nav-overlay" class="pointer-events-none fixed inset-0 z-30 hidden bg-black/50 opacity-0 transition-opacity duration-300 lg:block"></div>

<header id="site-header" class="fixed inset-x-0 top-0 z-50 flex items-center justify-between px-5 py-3 transition-transform duration-300 ease-in-out lg:px-7">
  <nav
    id="site-navbar"
    class="relative mx-auto flex w-full max-w-5xl items-center justify-between rounded-full bg-transparent px-4 py-1.5 transition-[backdrop-filter,box-shadow,background-color] duration-500 lg:backdrop-blur-0"
    aria-label="Main Navigation"
  >
    <a href={localizedPath('/', locale)} class="relative z-50 flex items-center gap-1 focus:outline-none" aria-label="Awan Kusuma Legalitas">
      <img
        id="site-nav-logo"
        src="/assets/image/logo-160.webp"
        alt="Awan Kusuma Legalitas Logo"
        width="64"
        height="64"
        decoding="async"
        class="h-12 w-12 object-contain transition-[filter] duration-300 sm:h-14 sm:w-14 lg:h-16 lg:w-16"
      />
    </a>

    <ul class="ml-auto mr-4 hidden items-center gap-4 text-[11px] font-bold tracking-wider text-black lg:flex xl:mr-8 xl:gap-6 xl:text-xs">
      {
        navItems.map((item) => (
          <li class:list={['group py-4', item.services && 'site-services-trigger']}>
            <a
              href={localizedPath(item.href, locale)}
              class:list={['relative inline-block transition-colors focus:outline-none hover:text-elm', isActive(item.href) && 'text-elm']}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              <span class="flex items-center gap-2">
                {item.key === 'tools' && <span class="h-1.5 w-1.5 rotate-45 bg-orange-400"></span>}
                {item.literal ?? translate(messages, `navbar.${item.key}`)}
              </span>
              <span class:list={[
                'absolute -bottom-0.5 left-1/2 h-0.5 -translate-x-1/2 bg-elm transition-[width] duration-300 group-hover:w-full',
                isActive(item.href) ? 'w-full' : 'w-0',
              ]}></span>
            </a>

            {
              item.services && (
                <div class="site-services-menu invisible absolute left-0 top-full z-50 w-full translate-y-2 pt-6 opacity-0 transition-[opacity,visibility,transform] duration-300">
                  <div class="max-h-[75vh] w-full overflow-y-auto rounded-2xl border border-gray-100 bg-white p-8 shadow-2xl">
                    <div class="grid grid-cols-1 items-start gap-8 md:grid-cols-3 lg:grid-cols-5">
                      {categories.map((group) => {
                        const visibleItems = group.items.filter((service) => !service.hide_from_menu && service.name);
                        if (!group.category || visibleItems.length === 0) return null;

                        return (
                          <div class="flex flex-col gap-3">
                            <h2 class="mb-2 border-b border-gray-100 pb-2 text-[11px] font-extrabold uppercase tracking-wider text-slate-800 lg:text-[13px]">
                              {group.category}
                            </h2>
                            <ul class="flex flex-col gap-2">
                              {visibleItems.map((service) => {
                                const Icon = getServiceIcon(service.icon_name);

                                return (
                                  <li>
                                    <a
                                      href={localizedPath(`/layanan/${service.slug.split('#')[0]}`, locale)}
                                      class="group/service-item flex items-start gap-2 text-slate-500 transition-colors hover:text-elm"
                                    >
                                      <span class="mt-0.5 shrink-0 text-slate-400 transition-colors group-hover/service-item:text-elm" aria-hidden="true">
                                        <Icon size={14} strokeWidth={2} />
                                      </span>
                                      <span class="text-[11px] font-semibold leading-relaxed normal-case tracking-normal lg:text-xs">{service.name}</span>
                                    </a>
                                  </li>
                                );
                              })}
                            </ul>
                          </div>
                        );
                      })}
                    </div>
                  </div>
                </div>
              )
            }
          </li>
        ))
      }
    </ul>

    <div class="relative z-50 hidden items-center gap-2 lg:flex xl:gap-3">
      <LanguageSwitcher links={localeLinks} variant="desktop" />
      <AuthNav
        variant="desktop"
        backendOrigin={backendOrigin}
        loginHref={localizedPath('/login', locale)}
        customerHref={localizedPath('/lacak', locale)}
        partnerHref={localizedPath('/mitra', locale)}
        labels={authLabels}
      />
      <a
        href={localizedPath('/kontak', locale)}
        class="whitespace-nowrap rounded-full bg-big-stone px-5 py-2 text-[11px] font-bold text-white transition-colors hover:bg-elm xl:px-6 xl:py-2.5 xl:text-xs"
      >
        {translate(messages, 'navbar.contactUs')}
      </a>
    </div>

    <button
      id="site-menu-toggle"
      type="button"
      class="relative z-50 ml-auto flex size-12 items-center justify-center rounded-full bg-[#1C2D3C] text-white transition-[background-color,color,transform] duration-500 lg:hidden"
      aria-label="Toggle Menu"
      aria-controls="site-mobile-menu"
      aria-expanded="false"
    >
      <span class="relative flex h-5 w-6 items-center justify-center" aria-hidden="true">
        <span class="site-menu-line absolute right-0 block h-[1.5px] w-full rounded-full bg-current"></span>
        <span class="site-menu-line absolute right-0 block h-[1.5px] w-4 rounded-full bg-current"></span>
      </span>
    </button>
  </nav>
</header>

<aside
  id="site-mobile-menu"
  class="invisible fixed inset-0 z-40 flex h-full w-full flex-col overflow-y-auto bg-[#1e2329] px-6 pb-10 pt-24 text-white lg:hidden"
  aria-hidden="true"
  data-state="closed"
  inert
>
  <nav class="flex min-h-full flex-1 flex-col" aria-label="Mobile Navigation">
    <ul class="mt-8 flex flex-col gap-6 text-2xl font-bold uppercase tracking-widest text-white sm:text-3xl">
      {mobileNavItems.map((item) => (
        <li class="menu-item">
          <a
            href={localizedPath(item.href, locale)}
            class="flex items-center gap-3 transition-colors hover:text-orange-400 focus-visible:text-orange-400 focus-visible:outline-none"
          >
            {item.key === 'tools' && <span class="h-2.5 w-2.5 rotate-45 bg-orange-400" aria-hidden="true"></span>}
            {item.literal ?? translate(messages, `navbar.${item.key}`)}
          </a>
        </li>
      ))}
    </ul>

    <LanguageSwitcher links={localeLinks} variant="mobile" />

    <div class="mt-10 flex flex-col gap-3">
      <div class="menu-item">
        <AuthNav
          variant="mobile"
          backendOrigin={backendOrigin}
          loginHref={localizedPath('/login', locale)}
          customerHref={localizedPath('/lacak', locale)}
          partnerHref={localizedPath('/mitra', locale)}
          labels={authLabels}
        />
      </div>
      <a href={localizedPath('/kontak', locale)} class="menu-item flex w-full items-center justify-center rounded-full bg-elm px-6 py-4 text-sm font-bold tracking-widest text-white">
        <span>{translate(messages, 'navbar.contactUs')}</span>
        <svg class="ml-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="square" stroke-linejoin="miter" stroke-width="2" d="M10 6H6a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
        </svg>
      </a>
    </div>

    <div class="mt-10 flex flex-col items-center gap-2 text-[8px] uppercase tracking-widest text-gray-400 sm:text-[10px]">
      <div class="menu-item flex items-center gap-2">
        <a href={localizedPath('/kebijakan-privasi', locale)} class="transition-colors hover:text-white focus-visible:text-white focus-visible:outline-none">
          {translate(messages, 'navbar.privacyPolicy')}
        </a>
      </div>
      <p class="menu-item mt-4">{translate(messages, 'navbar.copyright')}</p>
    </div>
  </nav>
</aside>

<style is:inline>
  html.site-menu-open,
  html.site-menu-open body {
    overflow: hidden;
    overscroll-behavior: none;
  }

  #site-mobile-menu {
    --menu-origin: calc(100% - 60px) 42px;
    clip-path: circle(0 at var(--menu-origin));
    contain: layout paint style;
    overscroll-behavior: contain;
    transition: clip-path 600ms cubic-bezier(0.76, 0, 0.24, 1);
  }

  #site-mobile-menu[data-state='open'] {
    clip-path: circle(150% at var(--menu-origin));
  }

  #site-mobile-menu[data-state='closing'] {
    clip-path: circle(0 at var(--menu-origin));
    transition-delay: 150ms;
  }

  #site-mobile-menu .menu-item {
    opacity: 0;
    transform: translate3d(0, 30px, 0);
  }

  #site-mobile-menu[data-state='open'] .menu-item {
    opacity: 1;
    transform: translate3d(0, 0, 0);
    transition:
      opacity 400ms ease-out var(--menu-open-delay, 400ms),
      transform 400ms cubic-bezier(0.16, 1, 0.3, 1) var(--menu-open-delay, 400ms);
  }

  #site-mobile-menu[data-state='closing'] .menu-item {
    opacity: 0;
    transform: translate3d(0, 30px, 0);
    transition:
      opacity 220ms ease-in var(--menu-close-delay, 0ms),
      transform 220ms ease-in var(--menu-close-delay, 0ms);
  }

  #site-menu-toggle,
  #site-menu-toggle .site-menu-line,
  #site-nav-logo {
    transition-duration: 500ms;
    transition-timing-function: cubic-bezier(0.76, 0, 0.24, 1);
  }

  #site-menu-toggle .site-menu-line {
    transition-property: width, transform;
  }

  #site-menu-toggle .site-menu-line:first-child {
    transform: translateY(-6px);
  }

  #site-menu-toggle .site-menu-line:last-child {
    transform: translateY(6px);
  }

  #site-menu-toggle[aria-expanded='true'] {
    color: #000;
    background: #fff;
    transform: scale(1.05);
  }

  #site-menu-toggle[aria-expanded='true'] .site-menu-line:first-child {
    width: 100%;
    transform: translateY(0) rotate(45deg);
  }

  #site-menu-toggle[aria-expanded='true'] .site-menu-line:last-child {
    width: 100%;
    transform: translateY(0) rotate(-45deg);
  }

  #site-nav-logo[data-menu-open='true'] {
    filter: brightness(0) invert(1);
  }

  #site-menu-toggle:focus-visible {
    outline: 2px solid #fb923c;
    outline-offset: 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    #site-mobile-menu,
    #site-mobile-menu .menu-item,
    #site-menu-toggle,
    #site-menu-toggle .site-menu-line,
    #site-nav-logo {
      transition-duration: 0.01ms !important;
      transition-delay: 0ms !important;
    }
  }
</style>

<script is:inline>
  (() => {
    const header = document.getElementById('site-header');
    const navbar = document.getElementById('site-navbar');
    const toggle = document.getElementById('site-menu-toggle');
    const menu = document.getElementById('site-mobile-menu');
    const logo = document.getElementById('site-nav-logo');
    const overlay = document.getElementById('site-nav-overlay');
    const servicesTrigger = document.querySelector('.site-services-trigger');
    const servicesMenu = document.querySelector('.site-services-menu');
    const menuItems = [...(menu?.querySelectorAll('.menu-item') ?? [])];
    const desktopMedia = window.matchMedia('(min-width: 1024px)');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let lastScrollY = window.scrollY;
    let closeTimer = 0;
    let settleTimer = 0;

    menuItems.forEach((item, index) => {
      item.style.setProperty('--menu-open-delay', `${400 + index * 50}ms`);
      item.style.setProperty('--menu-close-delay', `${(menuItems.length - 1 - index) * 18}ms`);
    });

    const updateHeader = () => {
      const current = window.scrollY;
      const isScrolled = current > 60;
      header?.classList.toggle('-translate-y-full', current > lastScrollY && current > 50);
      navbar?.classList.toggle('lg:backdrop-blur-xs', isScrolled);
      navbar?.classList.toggle('lg:backdrop-blur-0', !isScrolled);
      navbar?.classList.toggle('lg:shadow-lg', isScrolled);
      navbar?.classList.remove('bg-white/85');
      lastScrollY = current;
    };

    const finishClose = () => {
      if (!menu || menu.dataset.state !== 'closing') return;
      menu.dataset.state = 'closed';
      menu.classList.add('invisible');
      menu.style.removeProperty('will-change');
    };

    const closeMenu = ({ restoreFocus = false } = {}) => {
      if (toggle?.getAttribute('aria-expanded') !== 'true') return;
      window.clearTimeout(closeTimer);
      window.clearTimeout(settleTimer);
      toggle?.setAttribute('aria-expanded', 'false');
      toggle?.setAttribute('aria-label', 'Open Menu');
      menu?.setAttribute('aria-hidden', 'true');
      menu?.setAttribute('inert', '');
      if (menu) {
        menu.dataset.state = 'closing';
        menu.style.willChange = 'clip-path';
      }
      logo?.setAttribute('data-menu-open', 'false');
      document.documentElement.classList.remove('site-menu-open');
      closeTimer = window.setTimeout(finishClose, reducedMotion.matches ? 0 : 850);
      if (restoreFocus) toggle?.focus({ preventScroll: true });
    };

    toggle?.addEventListener('click', () => {
      const opening = toggle.getAttribute('aria-expanded') !== 'true';
      if (!opening) return closeMenu();
      window.clearTimeout(closeTimer);
      window.clearTimeout(settleTimer);
      toggle.setAttribute('aria-expanded', 'true');
      toggle.setAttribute('aria-label', 'Close Menu');
      menu?.setAttribute('aria-hidden', 'false');
      menu?.removeAttribute('inert');
      menu?.classList.remove('invisible');
      if (menu) {
        menu.style.willChange = 'clip-path';
        menu.dataset.state = 'closed';
        void menu.offsetWidth;
        menu.dataset.state = 'open';
      }
      logo?.setAttribute('data-menu-open', 'true');
      document.documentElement.classList.add('site-menu-open');
      settleTimer = window.setTimeout(() => menu?.style.removeProperty('will-change'), 1400);
    });

    menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') closeMenu({ restoreFocus: true });
    });
    desktopMedia.addEventListener('change', (event) => {
      if (event.matches) closeMenu();
    });
    servicesTrigger?.addEventListener('mouseenter', () => {
      servicesMenu?.classList.remove('invisible', 'translate-y-2', 'opacity-0');
      overlay?.classList.remove('opacity-0');
      overlay?.classList.add('opacity-100');
    });
    servicesTrigger?.addEventListener('mouseleave', () => {
      servicesMenu?.classList.add('invisible', 'translate-y-2', 'opacity-0');
      overlay?.classList.add('opacity-0');
      overlay?.classList.remove('opacity-100');
    });
    window.addEventListener('scroll', updateHeader, { passive: true });
    updateHeader();
  })();
</script>
