---
import type { Locale } from '../../config/site';
import { articleImageUrl, type ArticleSummary } from '../../lib/articles';
import { localizedPath } from '../../lib/i18n';

interface Props {
  article: ArticleSummary;
  locale: Locale;
  priority?: boolean;
}

const { article, locale, priority = false } = Astro.props;
const href = localizedPath(`/info-bisnis/${article.slug}`, locale);
const dateLocale = locale === 'id' ? 'id-ID' : locale === 'zh' ? 'zh-CN' : 'en-US';
const publishedAt = article.published_at
  ? new Intl.DateTimeFormat(dateLocale, { day: 'numeric', month: 'short', year: 'numeric' })
      .format(new Date(article.published_at))
  : null;
---

<a href={href} data-article-cursor-card class="group relative flex h-full w-full flex-col">
  <div class="relative mb-5 aspect-video w-full shrink-0 overflow-hidden rounded-md bg-gray-100 md:aspect-[5/3]">
    <img
      src={articleImageUrl(article.featured_image || article.image)}
      alt={article.featured_image_alt || article.title}
      width="640"
      height="384"
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
      decoding="async"
      data-cms-responsive
      sizes="(min-width: 1280px) 544px, (min-width: 768px) calc(50vw - 3rem), calc(100vw - 2.5rem)"
      class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
    />
  </div>

  {publishedAt && (
    <time
      datetime={article.published_at || undefined}
      class="mb-2 block text-[10px] font-bold uppercase tracking-widest text-slate-400"
    >
      {publishedAt}
    </time>
  )}

  <h3 class="mb-4 line-clamp-3 flex-1 text-[16px] font-bold leading-[1.6] text-slate-800 transition-colors group-hover:text-elm md:text-[18px]">
    {article.title}
  </h3>

  {article.category?.name && (
    <div class="mt-auto flex shrink-0 items-center gap-3 pt-2">
      <span class="rounded-sm bg-elm/10 px-2.5 py-1 text-[11px] font-bold uppercase tracking-widest text-elm">
        {article.category.name}
      </span>
    </div>
  )}
</a>
