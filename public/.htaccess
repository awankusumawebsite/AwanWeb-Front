Options -Indexes
ErrorDocument 404 /404.html

<IfModule mod_dir.c>
  DirectoryIndex index.html
  DirectorySlash Off
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Pertahankan satu host canonical setelah apex dan www pindah dari Vercel.
  RewriteCond %{HTTP_HOST} ^www\.awankusuma\.com$ [NC]
  RewriteRule ^ https://awankusuma.com%{REQUEST_URI} [R=301,L,NE]

  # Redirect permanen URL lama yang sebelumnya ditangani Next.js.
  RewriteRule ^about-us/?$ /tentang-kami [R=301,L,NE]
  RewriteRule ^(en|zh)/about-us/?$ /$1/tentang-kami [R=301,L,NE]
  RewriteRule ^tracking/?$ / [R=301,L,NE]
  RewriteRule ^(en|zh)/tracking/?$ /$1 [R=301,L,NE]

  RewriteRule ^info-bisnis/info-bisnisperubahan-cara-migrasi-kbli-2025/?$ /info-bisnis/perubahan-cara-migrasi-kbli-2025 [R=301,L,NE]
  RewriteRule ^(en|zh)/info-bisnis/info-bisnisperubahan-cara-migrasi-kbli-2025/?$ /$1/info-bisnis/perubahan-cara-migrasi-kbli-2025 [R=301,L,NE]

  RewriteRule ^blogPost(?:/[0-9]+)?/?$ /info-bisnis [R=301,L,NE,NC]
  RewriteRule ^(en|zh)/blogPost(?:/[0-9]+)?/?$ /$1/info-bisnis [R=301,L,NE,NC]
  RewriteRule ^auth(?:/.*)?$ /login [R=301,L,NE]
  RewriteRule ^(en|zh)/auth(?:/.*)?$ /$1/login [R=301,L,NE]
  RewriteRule ^layanan/[0-9]+/?$ /layanan [R=301,L,NE]
  RewriteRule ^(en|zh)/layanan/[0-9]+/?$ /$1/layanan [R=301,L,NE]

  RewriteRule ^(?:cookie|privacy)/?$ /kebijakan-privasi [R=301,L,NE]
  RewriteRule ^(en|zh)/(?:cookie|privacy)/?$ /$1/kebijakan-privasi [R=301,L,NE]

  # Redirect route Next lama ke representasi detail portal static Astro.
  RewriteRule ^((?:en|zh)/)?mitra/orders/([^/]+)/?$ /$1mitra?order=$2 [R=302,L,NE]

  # Redirect FAQ lama ke bagian FAQ di halaman Kontak.
  RewriteRule ^faq/?$ /kontak#faq [R=301,L,NE]
  RewriteRule ^(en|zh)/faq/?$ /$1/kontak#faq [R=301,L,NE]

  # Normalisasi query pagination Next lama menjadi path static Astro.
  RewriteCond %{QUERY_STRING} ^category=([A-Za-z0-9-]+)&page=1$
  RewriteRule ^((?:en|zh)/)?info-bisnis/?$ /$1info-bisnis/kategori/%1 [R=301,L,NE,QSD]
  RewriteCond %{QUERY_STRING} ^page=1&category=([A-Za-z0-9-]+)$
  RewriteRule ^((?:en|zh)/)?info-bisnis/?$ /$1info-bisnis/kategori/%1 [R=301,L,NE,QSD]

  RewriteCond %{QUERY_STRING} ^category=([A-Za-z0-9-]+)&page=([2-9][0-9]*)$
  RewriteRule ^((?:en|zh)/)?info-bisnis/?$ /$1info-bisnis/kategori/%1/page/%2 [R=301,L,NE,QSD]
  RewriteCond %{QUERY_STRING} ^page=([2-9][0-9]*)&category=([A-Za-z0-9-]+)$
  RewriteRule ^((?:en|zh)/)?info-bisnis/?$ /$1info-bisnis/kategori/%2/page/%1 [R=301,L,NE,QSD]

  RewriteCond %{QUERY_STRING} ^category=([A-Za-z0-9-]+)$
  RewriteRule ^((?:en|zh)/)?info-bisnis/?$ /$1info-bisnis/kategori/%1 [R=301,L,NE,QSD]
  RewriteCond %{QUERY_STRING} ^page=1$
  RewriteRule ^((?:en|zh)/)?info-bisnis/?$ /$1info-bisnis [R=301,L,NE,QSD]
  RewriteCond %{QUERY_STRING} ^page=([2-9][0-9]*)$
  RewriteRule ^((?:en|zh)/)?info-bisnis/?$ /$1info-bisnis/page/%1 [R=301,L,NE,QSD]

  # Tool dibuat dan diaktifkan dari CMS setelah build Astro. Semua slug tool
  # yang belum memiliki file static dilayani oleh satu runtime shell; URL asli
  # tetap dipertahankan agar card CMS dapat langsung dibuka tanpa redeploy.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^tools/([a-z0-9]+(?:-[a-z0-9]+)*)/?$ /tools/runner/index.html [END]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(en|zh)/tools/([a-z0-9]+(?:-[a-z0-9]+)*)/?$ /$1/tools/runner/index.html [END]

  # Apache DirectorySlash menambahkan slash pada directory static. Kontrak URL
  # dan canonical Next memakai tanpa slash, jadi normalisasikan versi slash lalu
  # layani index.html secara internal agar URL canonical langsung 200.
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteCond %{REQUEST_URI} !^/$
  RewriteCond %{THE_REQUEST} \s/+[^?[:space:]]+/[?[:space:]] [NC]
  RewriteRule ^(.+)/$ /$1 [R=301,L,NE]

  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.+?)/?$ $1/index.html [END]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set X-DNS-Prefetch-Control "on"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(?:css|js|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(?:avif|webp|png|jpe?g|gif|svg|ico|webm|mp4)$">
    Header set Cache-Control "public, max-age=2592000, stale-while-revalidate=86400"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>
